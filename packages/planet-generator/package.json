{
  "name": "@megaplanets/planet-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "golden": "vitest run tests/generator.test.ts",
    "golden:update": "tsx scripts/generate-golden.ts",
    "landing:generate": "tsx scripts/generate-landing-previews.ts"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "simplex-noise": "^4.0.3",
    "viem": "^2.21.0",
    "webm-wasm": "0.4.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
