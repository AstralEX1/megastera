# Megastera local development environment
# Copy to .env.local and fill in only the values needed for your environment.

# Public frontend configuration
VITE_APP_NAME=Megastera
VITE_CHAIN=testnet
VITE_RPC_URL=https://sepolia.base.org
# Optional comma-separated browser RPC fallbacks.
# VITE_RPC_FALLBACK_URLS=https://base-sepolia-rpc.publicnode.com
VITE_REFERRER_ADDRESS=0xCfc1044C749fD40E07FE33938414Fa573993F857
VITE_WALLETCONNECT_PROJECT_ID=

# Megapot Data API. Empty uses the anonymous public API tier.
VITE_MEGAPOT_API_KEY=
VITE_API_BASE_URL=

# Backend API base. Empty uses same-origin local development.
VITE_BACKEND_API_BASE_URL=

# Server-only backend Planet configuration
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional comma-separated fallback RPCs for receipt verification.
# BASE_SEPOLIA_RPC_FALLBACK_URLS=https://base-sepolia-rpc.publicnode.com
DATABASE_URL=postgresql://user:password@localhost:5432/megastera
# Receipt proofs are accepted only after this many newer canonical blocks.
MEGAPLANETS_CONFIRMATIONS=6

# Optional standalone API listener configuration
# MEGAPLANETS_API_HOST=127.0.0.1
# MEGAPLANETS_API_PORT=8787
# MEGAPLANETS_ALLOWED_ORIGINS=http://localhost:5173
# MEGAPLANETS_WORKER_TOKEN=
