# Megastera mainnet environment template
# Copy to .env.local and fill in secrets locally. Never commit real credentials here.

# Public frontend configuration
VITE_APP_NAME=Megastera
VITE_RPC_URL=https://mainnet.base.org
# Optional comma-separated browser RPC fallbacks. Use public endpoints or placeholders;
# provider credentials belong in the hosting provider, not in this file.
VITE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com
VITE_WALLETCONNECT_PROJECT_ID=
VITE_API_BASE_URL=/api/megapot
VITE_BACKEND_API_BASE_URL=

# Server-only Megapot mainnet Data API key. Never use a VITE_* prefix.
MEGAPOT_API_KEY=mpk_live_REPLACE_ME

# Server-only backend Planet configuration
BASE_RPC_URL=https://mainnet.base.org
# Optional comma-separated receipt RPC fallbacks.
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com

# Supabase transaction pooler for Vercel runtime (port 6543).
DATABASE_URL=postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true
# Supabase direct or session-pooler URL for `pnpm db:deploy` (port 5432).
DIRECT_URL=postgresql://prisma.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Receipt proofs are accepted only after this many newer canonical blocks.
MEGAPLANETS_CONFIRMATIONS=6

# Optional standalone API listener configuration
# MEGAPLANETS_API_HOST=127.0.0.1
# MEGAPLANETS_API_PORT=8787
# MEGAPLANETS_ALLOWED_ORIGINS=http://localhost:5173
# MEGAPLANETS_WORKER_TOKEN=
