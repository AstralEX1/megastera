{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    { "path": "/api/internal/leaderboard-worker", "schedule": "5 0 * * *" }
  ],
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
